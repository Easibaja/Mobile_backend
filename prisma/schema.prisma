generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id
  provider  String
  email     String?
  name      String?
  picture   String?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  favorites Favorite[]
  settings  UserSettings?
  tickets   Ticket[]

  @@unique([provider, email])
  @@map("users")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  placeId   String   @map("place_id")
  name      String?
  address   String?
  lat       Float?
  lng       Float?
  types     String[]
  rating    Float?
  photoName String?  @map("photo_name")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([userId])
  @@map("favorites")
}

model UserSettings {
  userId          String   @id @map("user_id")
  units           String   @default("km")
  searchRadius    Int      @default(15000) @map("search_radius")
  themePreference String   @default("auto") @map("theme_preference")
  notifications   Boolean  @default(true)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Ticket {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  placeId         String   @map("place_id")
  placeName       String   @map("place_name")
  productId       String   @map("product_id")
  productLabel    String   @map("product_label")
  amountMinor     Int      @map("amount_minor")
  currency        String
  status          String   @default("valid")
  qrToken         String   @unique @map("qr_token")
  paymentIntentId String   @unique @map("payment_intent_id")
  purchasedAt     DateTime @default(now()) @map("purchased_at") @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("tickets")
}
